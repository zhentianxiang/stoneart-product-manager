# ============================================================
# Stone Art Product Manager 配置示例
# 复制为 config.local.env 后填写真实值：
# cp config.example.env config.local.env
# chmod 600 config.local.env
# ============================================================

# ---------- 网站后台 ----------
STONEART_BASE_URL=https://www.stoneartsculpture.com
STONEART_ADMIN_USER=admin
STONEART_ADMIN_PASSWORD=change-me

# ---------- 本地 Qwen3-VL 图片理解（Codex 之后的第一备用） ----------
# 当前对话中的 Codex 识图仍为第一优先；只有 Codex 无法可靠识图时才调用本地模型。
# 本地不可用、超时或返回无效结果时，脚本自动回退 DeepSeek。
LOCAL_VISION_ENABLED=true
LOCAL_VISION_BASE_URL=http://120.10.255.14:7893/v1
LOCAL_VISION_MODEL=Qwen3-VL-30B-A3B-Instruct
LOCAL_VISION_API_KEY=
LOCAL_VISION_TIMEOUT=180
LOCAL_VISION_MAX_TOKENS=4000

# ---------- DeepSeek 文本与最终图片理解兜底 ----------
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=change-me
DEEPSEEK_MODEL=deepseek-flash

# ---------- 本地 Qwen-Image-2.1 产品封面图（优先） ----------
# 先调用本地编辑模型；健康检查失败、超时或无结果时自动回退 Wan2.7。
LOCAL_IMAGE_ENABLED=true
LOCAL_IMAGE_BASE_URL=http://120.10.255.14:7890/v1
LOCAL_IMAGE_MODEL=qwen-image-2.1
LOCAL_IMAGE_API_KEY=
LOCAL_IMAGE_TIMEOUT=960
LOCAL_IMAGE_HEALTH_TIMEOUT=5
LOCAL_IMAGE_STEPS=40

# ---------- 阿里云百炼 Wan2.7 产品封面图（本地不可用时回退） ----------
ALIYUN_WAN_COMPATIBLE_BASE_URL=https://llm-v3z08l00fgpgh0fo.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
ALIYUN_WAN_DASHSCOPE_BASE_URL=https://llm-v3z08l00fgpgh0fo.cn-beijing.maas.aliyuncs.com/api/v1
ALIYUN_DASHSCOPE_API_KEY=change-me
WAN_IMAGE_MODEL=wan2.7-image
PRODUCT_COVER_AI_SIZE=2K
PRODUCT_COVER_AI_PROMPT=请移除所有水印和覆盖文字；保留雕塑主体，不得变形或重绘。无论原图已有天空、树木、阳光、草地或其他户外背景，都必须完全替换为一个全新、独特、与雕塑材质和风格匹配的户外展示环境。大理石人物可使用优雅欧洲庭院或艺术展馆花园；喷泉、花盆、长椅可使用高级园林庭院或酒店花园；动物、抽象和金属雕塑可使用现代景观公园或极简建筑庭院。保持真实光影、地面接触和柔和投影，不添加文字、Logo、人物或无关物体，不改变图片尺寸。

# ---------- 图片压缩 ----------
# 超过该字节数的图片会保持比例和尽可能高的清晰度压缩到限制以内。
PRODUCT_IMAGE_MAX_BYTES=1048576
PRODUCT_IMAGE_JPEG_QUALITY=90

# ---------- 产品图片水印 ----------
# 默认关闭；也可在单次命令中加 --watermark，使用 --no-watermark 强制跳过。
PRODUCT_WATERMARK_ENABLED=false
PRODUCT_WATERMARK_TEXT=Stone Art Sculpture
PRODUCT_WATERMARK_SUBTITLE=
# 六种方位：random / top-left / top-right / bottom-left / bottom-right /
# middle-left / middle-right。random 会从低纹理边缘区域中随机选择。
PRODUCT_WATERMARK_POSITION=random
# 彩色文字从左到右使用这些颜色插值。
PRODUCT_WATERMARK_COLORS=#f2b45b,#e06c75,#8f8dff,#5cc9c0
PRODUCT_WATERMARK_OPACITY=0.50
PRODUCT_WATERMARK_WIDTH_RATIO=0.42
PRODUCT_WATERMARK_MARGIN_RATIO=0.045
PRODUCT_WATERMARK_ROTATION_DEGREES=9
PRODUCT_WATERMARK_JPEG_QUALITY=94
PRODUCT_WATERMARK_FONT_PATH=assets/fonts/GreatVibes-Regular.ttf
# 留空时按图片内容和文字生成稳定随机种子；填写后便于复现位置。
PRODUCT_WATERMARK_SEED=

# ---------- 产品默认值 ----------
PRODUCT_BRAND_NAME=Stone Art Sculpture
PRODUCT_DEFAULT_STATUS=draft
PRODUCT_DEFAULT_PRICE=Contact for quotation
PRODUCT_DEFAULT_SORT_ORDER=0
# 当前有效 SKU 系列；留空则要求用户提供 sku。
# 例如 SAS-215 会从现有 SAS-215xx 中取下一个，生成 SAS-21559。
PRODUCT_AUTO_SKU_SERIES=

# ---------- 飞书产品变更通知 ----------
FEISHU_PRODUCT_NOTIFY_ENABLED=true
FEISHU_PRODUCT_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/change-me
FEISHU_PRODUCT_WEBHOOK_SECRET=change-me
FEISHU_TIMEZONE=Asia/Shanghai

# ---------- Local KB 官网同步 ----------
# 产品发布或已发布产品更新成功后，自动同步官网产品并触发知识索引。
# 同步失败不会回滚产品，只会在命令输出的 knowledge_sync 中报告。
LOCAL_KB_SYNC_ENABLED=false
LOCAL_KB_BASE_URL=https://ai.stoneartsculpture.com
LOCAL_KB_ADMIN_ORIGIN=https://ai.stoneartsculpture.com
LOCAL_KB_ADMIN_USERNAME=admin
LOCAL_KB_ADMIN_PASSWORD=change-me
LOCAL_KB_SYNC_PATH=/api/imports/stoneart/sync
LOCAL_KB_PREVIEW_PATH=/api/imports/stoneart/preview
LOCAL_KB_SYNC_TIMEOUT=300
LOCAL_KB_VERIFY_TLS=true
# 可选：自签证书或自定义 CA 文件路径。
# Cloudflare Origin 证书可使用 assets/cloudflare-origin-rsa-root.pem。
LOCAL_KB_CA_BUNDLE=
