# ============================================================
# Stone Art Product Manager 配置示例
# 复制为 config.local.env 后填写真实值：
# cp config.example.env config.local.env
# chmod 600 config.local.env
# ============================================================

# ---------- 网站后台 ----------
STONEART_BASE_URL=https://www.stoneartsculpture.com
STONEART_ADMIN_USER=admin
STONEART_ADMIN_PASSWORD=change-me

# ---------- DeepSeek 文本与图片理解 ----------
# 优先使用 Codex 自身识图；仅在无法可靠识图或需要结构化复核时调用。
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=change-me
DEEPSEEK_MODEL=deepseek-flash

# ---------- 阿里云百炼产品封面图 ----------
ALIYUN_WAN_COMPATIBLE_BASE_URL=https://llm-v3z08l00fgpgh0fo.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
ALIYUN_WAN_DASHSCOPE_BASE_URL=https://llm-v3z08l00fgpgh0fo.cn-beijing.maas.aliyuncs.com/api/v1
ALIYUN_DASHSCOPE_API_KEY=change-me
WAN_IMAGE_MODEL=wan2.7-image
PRODUCT_COVER_AI_SIZE=2K
PRODUCT_COVER_AI_PROMPT=请移除所有水印和覆盖文字；保留雕塑主体，不得变形或重绘。无论原图已有天空、树木、阳光、草地或其他户外背景，都必须完全替换为一个全新、独特、与雕塑材质和风格匹配的户外展示环境。大理石人物可使用优雅欧洲庭院或艺术展馆花园；喷泉、花盆、长椅可使用高级园林庭院或酒店花园；动物、抽象和金属雕塑可使用现代景观公园或极简建筑庭院。保持真实光影、地面接触和柔和投影，不添加文字、Logo、人物或无关物体，不改变图片尺寸。

# ---------- 图片压缩 ----------
# 超过该字节数的图片会保持比例和尽可能高的清晰度压缩到限制以内。
PRODUCT_IMAGE_MAX_BYTES=1048576
PRODUCT_IMAGE_JPEG_QUALITY=90

# ---------- 产品默认值 ----------
PRODUCT_BRAND_NAME=Stone Art Sculpture
PRODUCT_DEFAULT_STATUS=draft
PRODUCT_DEFAULT_PRICE=Contact for quotation
PRODUCT_DEFAULT_SORT_ORDER=0
# 当前有效 SKU 系列；留空则要求用户提供 sku。
# 例如 SAS-215 会从现有 SAS-215xx 中取下一个，生成 SAS-21559。
PRODUCT_AUTO_SKU_SERIES=

# ---------- 飞书产品变更通知 ----------
FEISHU_PRODUCT_NOTIFY_ENABLED=true
FEISHU_PRODUCT_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/change-me
FEISHU_PRODUCT_WEBHOOK_SECRET=change-me
FEISHU_TIMEZONE=Asia/Shanghai
